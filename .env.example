# Only the backend reads these values. Never commit your real .env.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: switch CHAT_PROVIDER to openai to use the OpenAI API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
API_TIMEOUT_SECONDS=30
# To try the interface without API access: CHAT_PROVIDER=mock

# Optional PostgreSQL + pgvector: run scripts/setup-memory-db.sh first.
# If omitted, local SQLite is used (exact in-process vector scoring, not pgvector).
MEMORY_DATABASE_URL=sqlite:///data/memory.sqlite3

# Weather API: Open-Meteo free non-commercial endpoint, no key/sign-up required.
# Per-browser consent defaults OFF in the weather settings page.
WEATHER_PROVIDER=openmeteo
# Fully offline weather demo: WEATHER_PROVIDER=mock (synthetic, not real weather).

# Online M5 controls; no additional keys. Mock has no semantic model review.
MEMORY_ROUTER_ENABLED=true
SEMANTIC_REVIEW_ENABLED=true
MEMORY_ROUTE_TIMEOUT_SECONDS=4
SEMANTIC_REVIEW_TIMEOUT_SECONDS=8

# Multilingual memory: semantic is the default; legacy is explicit historical replay only.
MEMORY_UNDERSTANDING_MODE=semantic
MEMORY_UNDERSTANDING_TIMEOUT_SECONDS=4
